# Banco de dados
POSTGRES_HOST=your_postgres_host
POSTGRES_USER=your_postgres_user
POSTGRES_PASS=your_postgres_pass
POSTGRES_DBMJ=your_postgres_db

# API
SERVER_PORT=8080
SPRING_APPLICATION_NAME=your_application_name
SPRING_DATASOURCE=jdbc:postgresql://${POSTGRES_HOST}:5432/${POSTGRES_DBMJ}
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Security
JWT_SECRET=YoutSecretKey
JWT_EXP_MIN=15
CORS_ALLOWED_ORIGINS=https://your_front_domain
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Pool/Hibernate
HIBERNATE_JDBC_FETCH_SIZE=50
HIBERNATE_CONNECTION_AUTOCOMMIT=false

# Logging
LOG_LEVEL=INFO
LOG_SQL=INFO
